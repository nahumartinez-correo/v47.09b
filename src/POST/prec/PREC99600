/****o* Pendientes de agrupacin/OFB:post:PREC99600
* NOMBRE
*   OFB:post:PREC99600
* DESCRIPCION
*   Rutina Pre Collect de la trx de Anulacion de Venta con Tarjeta.
* ENTRADAS
*   Parmetros de entrada de la rutina, sean argumentos o campos que tiene en cuenta
* SALIDAS
*   Campos modificados como resultado o returns cuyos valores sean no triviales
* IMPACTOS
*   Otros objetos que debern ser analizados al modificar el objeto actual
* REFERENCIADO POR
*   LST:post:TRAN99600
* DOCUMENTACION
*   NI50525 POS Integrado
* SOURCE
*/
#include "postprec.h"

SUB post:PREC99600
        LOCAL l_retval LIKE lib:err_retval
        LOCAL l_window_node_orig LIKE siaf:jnl_window_node
        LOCAL l_mensaje LIKE common:csr_string

        DPRINT "[DBG] --------------------------------------------------------------\n"
        DPRINT "[DBG] ---------------------- [PREC99600] ---------------------------\n"
        DPRINT "[DBG] [common:system_date][%s]\n" common:system_date
        DPRINT "[DBG] [giros:PresNro_canc][%s]\n" giros:PresNro_canc
        DPRINT "[DBG] [post:PresNro][%s]\n" post:PresNro
        DPRINT "[DBG] [op:op_operator_id][%s]\n" op:op_operator_id
        DPRINT "[DBG] [siaf:codigo_siaf esperado][99099]\n"
        DPRINT "[DBG] --------------------------------------------------------------\n"

        CDS SELECT FROM DSC:tlr:TABjnl BECOMES DSC:tlr:jnl_context WHERE \
                tlr:jnl_bus_date == common:system_date && \
                siaf:codigo_siaf == 99099 && \
                post:PresNro == giros:PresNro_canc && \
                siaf:moneda == "06" && \
                tlr:jnl_operator == op:op_operator_id

        CDS FINDFIRST DSC:tlr:jnl_context NOLOCK
        l_retval = CDSRETVAL
        DPRINT "[DBG] [PREC99600] CDSRETVAL[%d]\n" l_retval
        IF (l_retval == 0) THEN
                CDS EXTRACT DSC:tlr:jnl_context \
                        post:Total_importe \
                        post:codigo_interno \
                        post:NroCompPago2 \
                        post:Nro_Lote_Pos \
                        post:NroTransac \
                        post:Tipo_Operacion_Pos \
                        post:importe_origen \
                        siaf:moneda \
                        post:codigo_medio_pago \
                        post:DescripMedPag \
                        post:medio_pago_desc

                DPRINT "[DBG] ---------------- Journal base -------------------------------\n"
                DPRINT "[DBG] [post:Total_importe][%s]\n" post:Total_importe
                DPRINT "[DBG] [post:codigo_interno][%s]\n" post:codigo_interno
                DPRINT "[DBG] [post:NroCompPago2][%s]\n" post:NroCompPago2
                DPRINT "[DBG] [post:Nro_Lote_Pos][%s]\n" post:Nro_Lote_Pos
                DPRINT "[DBG] [post:NroTransac][%s]\n" post:NroTransac
                DPRINT "[DBG] [post:Tipo_Operacion_Pos][%s]\n" post:Tipo_Operacion_Pos
                DPRINT "[DBG] [siaf:moneda][%s]\n" siaf:moneda
                DPRINT "[DBG] [post:codigo_medio_pago][%s]\n" post:codigo_medio_pago
                DPRINT "[DBG] [post:DescripMedPag][%s]\n" post:DescripMedPag
                DPRINT "[DBG] [post:medio_pago_desc][%s]\n" post:medio_pago_desc
                DPRINT "[DBG] --------------------------------------------------------------\n"

                IF (post:codigo_interno == 130410) THEN
                        //gpb:NI50546 Mercado Pago
                        LET post:mp_payment_id = post:NroCompPago2
                        DPRINT "[DBG] [PREC99600] Flujo MP detectado (codigo_interno=130410) mp_payment_id inicial[%s]\n" post:mp_payment_id

                        CDS EXTRACT DSC:tlr:jnl_context \
                                post:codint_tarj_desc \
                                post:jnl_opmp_codseq_nro INTO post:adt_mp_codseq_nro \
                                post:jnl_opmp_codint_mp INTO post:mp_codint_mp \
                                post:jnl_opmp_description INTO post:mp_description \
                                post:jnl_opmp_device_name INTO post:mp_device_name \
                                post:jnl_opmp_status INTO post:mp_status

                        LET     post:adt_tmp_codint_mp = post:mp_codint_mp
                        DPRINT "[DBG] ---------------- MP basicos ------------------------------\n"
                        DPRINT "[DBG] [post:adt_mp_codseq_nro][%s]\n" post:adt_mp_codseq_nro
                        DPRINT "[DBG] [post:mp_codint_mp][%s]\n" post:mp_codint_mp
                        DPRINT "[DBG] [post:mp_description][%s]\n" post:mp_description
                        DPRINT "[DBG] [post:mp_device_name][%s]\n" post:mp_device_name
                        DPRINT "[DBG] [post:mp_status][%s]\n" post:mp_status
                        DPRINT "[DBG] --------------------------------------------------------------\n"

                  IF (post:mp_codint_mp == "QRI") THEN
                        //QR Integrado
                        //Cargo la info de la Orden
                        CDS EXTRACT DSC:tlr:jnl_context \
                                        post:jnl_opmp_currency_id INTO post:mp_currency_id  \
                                        post:jnl_opmp_quantity INTO post:mp_quantity
                        DPRINT "[DBG] ---------------- MP QR ------------------------------\n"
                        DPRINT "[DBG] [post:mp_currency_id][%s]\n" post:mp_currency_id
                        DPRINT "[DBG] [post:mp_quantity][%s]\n" post:mp_quantity
                        DPRINT "[DBG] --------------------------------------------------------------\n"
                        ELSE
                                //POINT Integrado
                                //Cargo la info de la Orden
                        CDS EXTRACT DSC:tlr:jnl_context \
                                        post:jnl_opmp_cc_type INTO post:mp_cc_type  \
                                        post:jnl_opmp_dis_bck_btn INTO post:mp_disable_back_btn \
                                        post:jnl_opmp_payer_email INTO post:mp_payer_email
                        DPRINT "[DBG] ---------------- MP Point -----------------------------\n"
                        DPRINT "[DBG] [post:mp_cc_type][%s]\n" post:mp_cc_type
                        DPRINT "[DBG] [post:mp_disable_back_btn][%s]\n" post:mp_disable_back_btn
                        DPRINT "[DBG] [post:mp_payer_email][%s]\n" post:mp_payer_email
                        DPRINT "[DBG] --------------------------------------------------------------\n"
                        END IF
                        //Cargo order_id,payment_id y payment_status
                CDS EXTRACT DSC:tlr:jnl_context \
                                post:jnl_opmp_order_id INTO post:mp_order_id \
                                post:jnl_opmp_payment_id INTO post:mp_payment_id \
                                post:jnl_opmp_status_pago INTO post:mp_status_pago
                        DPRINT "[DBG] ---------------- MP ids -------------------------------\n"
                        DPRINT "[DBG] [post:mp_order_id][%s]\n" post:mp_order_id
                        DPRINT "[DBG] [post:mp_payment_id][%s]\n" post:mp_payment_id
                        DPRINT "[DBG] [post:mp_status_pago][%s]\n" post:mp_status_pago
                        DPRINT "[DBG] --------------------------------------------------------------\n"

                        CDS EXTRACT DSC:tlr:jnl_context \
                                post:jnl_opmp_auth_code INTO post:mp_auth_code \
                                post:jnl_opmp_pay_method INTO post:mp_payment_method \
                                post:jnl_opmp_pay_type INTO post:mp_payment_type \
                                post:jnl_opmp_pay_date INTO post:mp_payment_date
                        DPRINT "[DBG] ---------------- MP pagos -----------------------------\n"
                        DPRINT "[DBG] [post:mp_auth_code][%s]\n" post:mp_auth_code
                        DPRINT "[DBG] [post:mp_payment_method][%s]\n" post:mp_payment_method
                        DPRINT "[DBG] [post:mp_payment_type][%s]\n" post:mp_payment_type
                        DPRINT "[DBG] [post:mp_payment_date][%s]\n" post:mp_payment_date
                        DPRINT "[DBG] --------------------------------------------------------------\n"
                ELSE
                        //gpb:NI50525 POS Integrado
                        CDS EXTRACT DSC:tlr:jnl_context \
                                post:adt_vpi_codseq_nro \
                                post:jnl_opvpi_issuerCode \
                                post:jnl_opvpi_merchaCode
                        DPRINT "[DBG] ---------------- VPI -------------------------------\n"
                        DPRINT "[DBG] [post:adt_vpi_codseq_nro][%s]\n" post:adt_vpi_codseq_nro
                        DPRINT "[DBG] [post:jnl_opvpi_issuerCode][%s]\n" post:jnl_opvpi_issuerCode
                        DPRINT "[DBG] [post:jnl_opvpi_merchaCode][%s]\n" post:jnl_opvpi_merchaCode
                        DPRINT "[DBG] --------------------------------------------------------------\n"
                END IF
                CDS EXTRACT DSC:tlr:jnl_context \
                        siaf:jnl_window_node INTO l_window_node_orig
                DPRINT "[DBG] [PREC99600] window_node_orig[%s]\n" l_window_node_orig
        END IF
        CDS ENDSELECT DSC:tlr:jnl_context
        DPRINT "[DBG] [PREC99600] ENDSELECT\n"

        IF (l_retval != 0) THEN
                DPRINT "[DBG] [PREC99600] Sin registros en journal -> retorno -2\n"
                RETURN -2
        END IF

        IF (l_window_node_orig != common:window_node) THEN
                FPRINT l_mensaje "Debe realizar la anulacion desde la terminal que realizo la venta [%s]",l_window_node_orig
                MSGBOX l_mensaje,OFB_OK ,"Aviso"
                UNGETKEY RT_ESC
                DPRINT "[DBG] [PREC99600] Terminal distinta -> orig[%s]\n" l_window_node_orig
                DPRINT "[DBG] [PREC99600] Terminal distinta -> actual[%s]\n" common:window_node
                RETURN -2
        END IF

        //Controlo si el cupon paso a tesoro
        tes:teso_cheq_moneda = siaf:moneda
        tes:teso_cheq_nro = post:NroCompPago2
        tes:teso_cheq_cuenta = post:codigo_interno
        tes:teso_cheq_banco = 0
        CALL tes:MISCbusco_cheque_rev
        IF (RETVAL == -1) THEN
                UNGETKEY RT_ESC
                DPRINT "[DBG] [PREC99600] Cupón en tesoro -> retorno -2\n"
                RETURN -2
        END IF

        CLEARFIELD tes:teso_cheq_moneda
        CLEARFIELD tes:teso_cheq_nro
        CLEARFIELD tes:teso_cheq_cuenta
        CLEARFIELD tes:teso_cheq_banco

        IF (post:codigo_interno == 130410) THEN
                //gpb:NI50546 Mercado Pago
                LET post:adt_tpos_codint_vpi = post:jnl_opmp_codint_mp
                DPRINT "[DBG] [PREC99600] MP set adt_tpos_codint_vpi[%s]\n" post:adt_tpos_codint_vpi
        ELSE
                //gpb:NI50525 POS Integrado
                //Obtengo la descripcion de la tarjeta a partir del codigo interno vpi
                LET post:adt_lcie_issuerCode = post:jnl_opvpi_issuerCode
                CALL post:CDSobt_CodInt_tarj
                LET codint_tarj_desc = post:jnl_lcie_CodIntDesc
                LET post:adt_tpos_codint_vpi = post:jnl_opvpi_issuerCode
                DPRINT "[DBG] [PREC99600] VPI set adt_tpos_codint_vpi[%s]\n" post:adt_tpos_codint_vpi
                DPRINT "[DBG] [PREC99600] VPI set codint_tarj_desc[%s]\n" codint_tarj_desc
        END IF
        LET post:importe_origen = post:Total_importe
        DPRINT "[DBG] [PREC99600] importe_origen set[%s]\n" post:importe_origen

        REFRESH post:Total_importe
        REFRESH post:codigo_interno
        REFRESH post:codint_tarj_desc
        REFRESH post:NroCompPago2
        REFRESH post:Nro_Lote_Pos
        REFRESH post:NroTransac
        REFRESH post:Tipo_Operacion_Pos

        LET post:Tipo_Operacion_PosAN = "ONLINE"
        REFRESH post:NroCompPago2AN
        REFRESH post:Nro_Lote_PosAN
        REFRESH post:NroTransacAN
        REFRESH post:Tipo_Operacion_PosAN

        DPRINT "[DBG] ****************[PREC99600]******************>>>\n"
END SUB

/*******/
